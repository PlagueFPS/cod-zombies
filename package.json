		"optimize:images": "bun scripts/image-optimization.ts",
		"generate:last:modified": "bun scripts/generate-last-modified.ts",
		"generate:image:paths": "bun scripts/generate-image-paths.ts",
		"generate:content:paths": "bun scripts/generate-content-paths.ts",
		"generate:og:images": "bun scripts/generate-og-images.tsx"
