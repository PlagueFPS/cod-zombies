{
	"name": "cod-zombies",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest --run",
		"test:all": "bun run test && bun run test:e2e",
