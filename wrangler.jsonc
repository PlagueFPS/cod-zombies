{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cod-zombies",
	"compatibility_date": "2026-07-04",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"preview_urls": true,
	"cache": { "enabled": true },
	"vars": {
		"LINEAR_TEAM_ID": "22b4c02d-1821-46b8-894c-f16e3e66ba9e",
	},
	"secrets": {
		"required": ["RESEND_API_KEY", "RESEND_AUDIENCE_ID", "LINEAR_API_KEY"],
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1,
		},
	},
}
